# O nome e a porta devem coincidir com connection.json e externalchaincode sync.
CHAINCODE_SERVER_ADDRESS=risk-factor:9999

# Substitua pelo PACKAGE_ID calculado ao instalar o chaincode no peer.
CHAINCODE_ID=risk-factor:COLE_AQUI_O_PACKAGE_ID

# Desenvolvimento local: a rede de teste não exige TLS entre peer e contêiner.
CHAINCODE_TLS_DISABLED=true
